<header id="header" class="l-header js-header">
	<h1 class="l-header__logo">
		<a href="<%= root %>index.html" class="l-header__logo--link js-pageTransitionLink" title="トップページへ">
			<span class="hd"><%= site.siteName %></span>
			<span class="l-header__logo--svg"></span>
		</a>
	</h1>
	<!-- BEGIN .l-header__inner -->
	<div class="l-header__inner">
		<div class="l-header__beacon">
			<div class="l-header__beacon--track">
				<p class="l-header__beacon--text">HIROSHI IGARASHI 2026 PORTFOLIO　/　HIROSHI IGARASHI 2026 PORTFOLIO　/　HIROSHI IGARASHI 2026 PORTFOLIO　/　</p>
				<p class="l-header__beacon--text">HIROSHI IGARASHI 2026 PORTFOLIO　/　HIROSHI IGARASHI 2026 PORTFOLIO　/　HIROSHI IGARASHI 2026 PORTFOLIO　/　</p>
			</div><!-- /.l-header__beacon--track -->
		</div><!-- /.l-header__beacon -->
		<div class="headerNavWrap">
			<nav class="headerNav">
				<ul class="headerNavLists">
					<li class="headerNavLists__item"><a href="<%= root %>index.html" class="headerNavLists__link js-pageTransitionLink">TOP</a></li>
					<li class="headerNavLists__item"><a href="<%= root %>products/index.html" class="headerNavLists__link js-pageTransitionLink">PRODUCTS</a></li>
					<li class="headerNavLists__item"><a href="<%= root %>private/index.html" class="headerNavLists__link js-pageTransitionLink">PRIVATE</a></li>
				</ul>
			</nav>
		</div><!-- /.headerNavWrap -->
	</div>
	<!-- END .l-header__inner -->
	<div class="l-header__navBtnWrap">
		<div class="l-header__navBtnWrap--blob"></div>
		<a href="javascript:;" class="l-header__navBtn js-navBtn">
			<div class="l-header__navBtnLineWrap">
				<span class="l-header__navBtn--line"></span>
				<span class="l-header__navBtn--line"></span>
			</div>
		</a>
	</div><!-- /.l-header__navBtnWrap -->
</header><!-- /#header -->
