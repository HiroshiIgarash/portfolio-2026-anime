<head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# article: http://ogp.me/ns/article#">
<meta charset="utf-8">
<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDescription %>">
<meta name="keywords" content="<%= site.keywords %>">
<meta property="og:site_name" content="<%= site.siteName %>">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:type" content="website">
<meta property="og:description" content="<%= pageDescription %>">
<meta property="og:url" content="<%= site.siteUrl %>">
<meta property="og:image" content="<%= site.siteUrl %><%= site.ogpImage %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="<%= site.twitterId %>">
<meta name="twitter:creator" content="<%= site.twitterId %>">
<meta name="twitter:title" content="<%= pageTitle %>">
<meta name="twitter:description" content="<%= pageDescription %>">
<meta name="twitter:image" content="<%= site.siteUrl %><%= site.ogpImage %>">
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
<meta name="format-detection" content="telephone=no, address=no, email=no">
<meta name="theme-color" content="<%= site.themeColor %>">
<!-- Web Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
<!-- End Web Fonts -->
<link href="<%= root %>assets/css/common.portfolio.css" rel="stylesheet" type="text/css">
<% if (pageCss) { -%>
<link href="<%= root %>assets/css/<%= pageCss %>.portfolio.css" rel="stylesheet" type="text/css">
<% } -%>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
<script>window.jQuery || document.write('<script src="<%= root %>assets/js/libs/jquery-3.7.1.min.js"><\/script>')</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.3/jquery.easing.min.js" integrity="sha384-mE6eXfrb8jxl0rzJDBRanYqgBxtJ6Unn4/1F7q4xRRyIw7Vdg9jP4ycT7x1iVsgb" crossorigin="anonymous"></script>
<script>window.jQuery.easing.def || document.write('<script src="<%= root %>assets/js/libs/jquery.easing.min.js"><\/script>')</script>
<link rel="manifest" href="<%= root %>manifest.json">
<link rel="shortcut icon" href="<%= root %>favicon.ico">
<link rel="apple-touch-icon" href="<%= root %>apple-touch-icon.png">
</head>
