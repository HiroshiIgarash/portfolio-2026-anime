<footer class="l-footer js-footer">
	<div class="l-footer__bendWrap" aria-hidden="true">
		<svg class="l-footer__bendSvg" viewBox="0 0 1200 60" preserveAspectRatio="none">
			<path class="js-footerBendPath l-footer__bendPath" d="M0,30 Q600,30 1200,30 L1200,60 L0,60 Z"></path>
		</svg>
	</div><!-- /.l-footer__bendWrap -->
	<div class="l-footer__inner">
		<div class="l-footer__innerCont">
			<p class="l-footer__logo">
				<a href="<%= root %>index.html" class="l-footer__logo--link js-pageTransitionLink" title="トップページへ">
					<span class="hd"><%= site.siteName %></span>
					<span class="l-footer__logo--svg"></span>
				</a>
			</p>
			<p class="l-footer__catch"><%= site.description %></p>
			<nav class="footerNav">
				<ul class="footerNavLists">
					<li class="footerNavLists__item"><a href="<%= root %>index.html" class="footerNavLists__link js-pageTransitionLink">TOP</a></li>
					<li class="footerNavLists__item"><a href="<%= root %>products/index.html" class="footerNavLists__link js-pageTransitionLink">PRODUCTS</a></li>
					<li class="footerNavLists__item"><a href="<%= root %>skills/index.html" class="footerNavLists__link js-pageTransitionLink">SKILLS</a></li>
					<li class="footerNavLists__item"><a href="<%= root %>off/index.html" class="footerNavLists__link js-pageTransitionLink">OFF</a></li>
				</ul>
			</nav>
			<a href="https://github.com/HiroshiIgarash" target="_blank" rel="noopener noreferrer" class="l-footer__githubLink">
				<span class="l-footer__githubLink--icon"></span>
				<span class="hd">GitHub</span>
			</a>
			<div class="l-footer__backTop">
				<a href="#top" class="l-footer__backTop--link js-anchor" title="ページの先頭へ戻る">
					<span class="l-footer__backTop--circleText" aria-hidden="true">
						<% const backTopChars = '加速装置・'.repeat(3).split(''); -%>
						<% backTopChars.forEach(function(char) { -%>
						<span class="l-footer__backTop--circleChar"><%= char %></span>
						<% }); -%>
					</span>
					<span class="l-footer__backTop--arrow">
						<span class="hd">ページの先頭へ戻る</span>
					</span>
				</a>
			</div><!-- /.l-footer__backTop -->
			<p class="l-footer__copyright"><%- site.copyright %></p>
		</div>
	</div><!-- /.l-footer__inner -->
</footer>
