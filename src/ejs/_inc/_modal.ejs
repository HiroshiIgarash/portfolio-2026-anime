<!-- BEGIN .modalBox -->
<div class="modalBox js-modalBox" data-lenis-prevent>
	<div class="closeBtn">
		<button class="closeBtn__btn js-modalClose">
			<span class="hd">CLOSE</span>
		</button>
	</div>

	<!-- BEGIN #projectModal01 -->
	<div id="projectModal01" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/hospital.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/hospital.jpg" alt="総合病院コーポレートサイト制作" width="1672" height="941">
				</picture>
				<p class="oneModalIn__cont--name">総合病院コーポレートサイト制作</p>
				<p class="oneModalIn__cont--text">Web制作会社在籍時に担当した総合病院のコーポレートサイト。診療科紹介ページ(WordPress定型テンプレート)だけで100ページを超える大規模案件で、コーディングは自分一人、各科ページ制作は5名体制で分担しました。</p>
			</div>
		</div>
	</div><!-- /#projectModal01 -->
	<!-- END #projectModal01 -->

	<!-- BEGIN #projectModal02 -->
	<div id="projectModal02" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/corporate.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/corporate.jpg" alt="Web制作期・コーポレートサイト多数" width="1672" height="941">
				</picture>
				<p class="oneModalIn__cont--name">Web制作期・コーポレートサイト多数</p>
				<p class="oneModalIn__cont--text">キャリア最初のエンジニア職として、Web制作会社で2年半従事。数十〜数百ページ規模のコーポレートサイト制作を多数担当し、WordPressを含むサイト構築やEJS / Webpack / SCSSでの制作フロー効率化にも取り組みました。</p>
			</div>
		</div>
	</div><!-- /#projectModal02 -->
	<!-- END #projectModal02 -->

	<!-- BEGIN #projectModal03 -->
	<div id="projectModal03" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/koremina.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/koremina.jpg" alt="コレミナ" width="1200" height="630">
				</picture>
				<p class="oneModalIn__cont--name">コレミナ</p>
				<p class="oneModalIn__cont--text">にじさんじ非公式のおすすめ動画共有サービス。個人開発でAuth.jsによるログイン機能、動画投稿・リアクション・ブックマークなどを実装。1,400件超の投稿が集まる個人開発の代表作です。</p>
			</div>
		</div>
	</div><!-- /#projectModal03 -->
	<!-- END #projectModal03 -->

	<!-- BEGIN #projectModal04 -->
	<div id="projectModal04" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/holo-comment.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/holo-comment.jpg" alt="ホロライブコメント検索" width="1200" height="630">
				</picture>
				<p class="oneModalIn__cont--name">ホロライブコメント検索</p>
				<p class="oneModalIn__cont--text">ホロライブ所属メンバーの配信ライブチャットを横断検索できるファンメイドツール。AWS + Cloudflareの構成をClaude Codeと1週間で立ち上げ、公開後も改善を継続しています。</p>
			</div>
		</div>
	</div><!-- /#projectModal04 -->
	<!-- END #projectModal04 -->

	<!-- BEGIN #projectModal05 -->
	<div id="projectModal05" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/tategamanga.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/tategamanga.jpg" alt="タテマンガ投稿Webサービス" width="1672" height="941">
				</picture>
				<p class="oneModalIn__cont--name">タテマンガ投稿Webサービス</p>
				<p class="oneModalIn__cont--text">大手出版社のタテマンガ投稿サービスの開発と保守を約1.5年担当。フロントエンドとバックエンドを横断し、URL限定公開機能やApp Router化リファクタリングなどを実装しました。</p>
			</div>
		</div>
	</div><!-- /#projectModal05 -->
	<!-- END #projectModal05 -->

	<!-- BEGIN #projectModal06 -->
	<div id="projectModal06" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/corporate.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/corporate.jpg" alt="コーポレートサイトリニューアル" width="1672" height="941">
				</picture>
				<p class="oneModalIn__cont--name">コーポレートサイトリニューアル</p>
				<p class="oneModalIn__cont--text">在籍していたWeb開発会社のコーポレートサイトリニューアルを担当。Headless CMSによる非エンジニアでも更新できる運用と、next-intlによる多言語化対応を実装しました。</p>
			</div>
		</div>
	</div><!-- /#projectModal06 -->
	<!-- END #projectModal06 -->

	<!-- BEGIN #projectModal07 -->
	<div id="projectModal07" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/holdings.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/holdings.jpg" alt="多角経営グループのコーポレートサイト制作" width="1672" height="941">
				</picture>
				<p class="oneModalIn__cont--name">多角経営グループのコーポレートサイト制作</p>
				<p class="oneModalIn__cont--text">Web制作会社在籍時、複数事業を展開する企業のコーポレートサイト制作を担当。静的ページ50ページ超に加え、ニュースと企業ブログをWordPressで構築。PHP・WordPress・JavaScript・Sassでコーディングは3名体制で進行しました。</p>
			</div>
		</div>
	</div><!-- /#projectModal07 -->
	<!-- END #projectModal07 -->

	<!-- BEGIN #projectModal08 -->
	<div id="projectModal08" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/candy.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/candy.jpg" alt="菓子ブランド公式サイトの保守・改修" width="1672" height="941">
				</picture>
				<p class="oneModalIn__cont--name">菓子ブランド公式サイトの保守・改修</p>
				<p class="oneModalIn__cont--text">Web制作会社在籍時、複雑なアニメーションを多用した菓子ブランドの公式サイト保守を担当。他社制作サイトで、新商品追加のたびに商品ページを追加し、既存のJavaScriptアニメーションのコードを読み解いた上で踏襲した改修を行いました。</p>
			</div>
		</div>
	</div><!-- /#projectModal08 -->
	<!-- END #projectModal08 -->
</div>
<!-- END .modalBox -->
