<!-- BEGIN .modalBox -->
<div class="modalBox js-modalBox" data-lenis-prevent>
	<div class="closeBtn">
		<button class="closeBtn__btn js-modalClose">
			<span class="hd">CLOSE</span>
		</button>
	</div>

	<!-- BEGIN #projectModal01 -->
	<div id="projectModal01" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/koremina.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/koremina.jpg" alt="コレミナ">
				</picture>
				<p class="oneModalIn__cont--name">コレミナ</p>
				<p class="oneModalIn__cont--text">にじさんじ非公式のおすすめ動画共有サービス。個人開発でAuth.jsによるログイン機能、動画投稿・リアクション・ブックマークなどを実装。1,400件超の投稿が集まる個人開発の代表作です。</p>
			</div>
		</div>
	</div><!-- /#projectModal01 -->
	<!-- END #projectModal01 -->

	<!-- BEGIN #projectModal02 -->
	<div id="projectModal02" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/holo-comment.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/holo-comment.jpg" alt="ホロライブコメント検索">
				</picture>
				<p class="oneModalIn__cont--name">ホロライブコメント検索</p>
				<p class="oneModalIn__cont--text">ホロライブ所属メンバーの配信ライブチャットを横断検索できるファンメイドツール。AWS + Cloudflareの構成をClaude Codeと1週間で立ち上げ、公開後も改善を継続しています。</p>
			</div>
		</div>
	</div><!-- /#projectModal02 -->
	<!-- END #projectModal02 -->

	<!-- BEGIN #projectModal03 -->
	<div id="projectModal03" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/tategamanga.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/tategamanga.jpg" alt="タテマンガ投稿Webサービス">
				</picture>
				<p class="oneModalIn__cont--name">タテマンガ投稿Webサービス</p>
				<p class="oneModalIn__cont--text">大手出版社のタテマンガ投稿サービスの開発と保守を約1.5年担当。フロントエンドとバックエンドを横断し、URL限定公開機能やApp Router化リファクタリングなどを実装しました。</p>
			</div>
		</div>
	</div><!-- /#projectModal03 -->
	<!-- END #projectModal03 -->

	<!-- BEGIN #projectModal04 -->
	<div id="projectModal04" class="oneModal">
		<div class="oneModalIn js-oneModalIn">
			<div class="oneModalIn__cont js-oneModalIn__cont">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects/corporate.webp" type="image/webp">
					<img class="oneModalIn__cont--img" src="<%= root %>assets/img/top/projects/corporate.jpg" alt="コーポレートサイトリニューアル">
				</picture>
				<p class="oneModalIn__cont--name">コーポレートサイトリニューアル</p>
				<p class="oneModalIn__cont--text">在籍していたWeb開発会社のコーポレートサイトリニューアルを担当。Headless CMSによる非エンジニアでも更新できる運用と、next-intlによる多言語化対応を実装しました。</p>
			</div>
		</div>
	</div><!-- /#projectModal04 -->
	<!-- END #projectModal04 -->
</div>
<!-- END .modalBox -->
