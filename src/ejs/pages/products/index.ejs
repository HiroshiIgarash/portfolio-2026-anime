<%
const root = '../';
const page = 'products';
const pageCss = 'products';
const pageJs = 'products';
-%>
<!doctype html>
<html lang="ja">
<%- include('../../_inc/_head', {
	root: root,
	page: page,
	pageTitle: '制作実績｜' + site.siteName,
	pageDescription: site.description,
	pageCss: pageCss,
	pageJs: pageJs
}) -%>
<body id="sub" data-page="<%= page %>" data-root="<%= root %>">
<!-- BEGIN #fullWrap -->
<div id="fullWrap">
<%- include('../../_inc/_loading') -%>
<%- include('../../_inc/_header', { root: root }) -%>
<main class="l-main">
	<article class="subArticle">
		<h1 class="contTitle2">
			<span class="contTitle2__en font-cinzel">PRODUCTS</span>
			<span class="contTitle2__ja">制作実績</span>
		</h1>
		<!-- BEGIN .productsSnap -->
		<div class="productsSnap js-productsSnap">
			<section class="productsIntro js-scrani js-productsSnapItem" data-products-index="0">
				<p class="productsIntro__count">05 WORKS</p>
				<h2 class="productsIntro__head">
					<span class="productsIntro__head--char"><span class="productsIntro__head--charIn">P</span></span>
					<span class="productsIntro__head--char"><span class="productsIntro__head--charIn">R</span></span>
					<span class="productsIntro__head--char"><span class="productsIntro__head--charIn">O</span></span>
					<span class="productsIntro__head--char"><span class="productsIntro__head--charIn">D</span></span>
					<span class="productsIntro__head--char"><span class="productsIntro__head--charIn">U</span></span>
					<span class="productsIntro__head--char"><span class="productsIntro__head--charIn">C</span></span>
					<span class="productsIntro__head--char"><span class="productsIntro__head--charIn">T</span></span>
					<span class="productsIntro__head--char"><span class="productsIntro__head--charIn">S</span></span>
				</h2>
				<p class="productsIntro__lead">個人開発と受託、5つのプロジェクトの記録</p>
				<p class="productsIntro__scroll">
					<span class="productsIntro__scroll--text">SCROLL</span>
					<span class="productsIntro__scroll--line"></span>
				</p>
			</section>
		</div>
		<!-- END .productsSnap -->
	</article>
</main>
<%- include('../../_inc/_footer', { root: root }) -%>
</div>
<!-- END #fullWrap -->

<%- include('../../_inc/_modal', { root: root }) -%>
<%- include('../../_inc/_scripts', { root: root, pageJs: pageJs }) -%>
</body>
</html>
