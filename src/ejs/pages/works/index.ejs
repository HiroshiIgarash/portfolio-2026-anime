<%
const root = '../';
const page = 'works';
const pageCss = 'works';
const pageJs = 'works';
-%>
<!doctype html>
<html lang="ja">
<%- include('../../_inc/_head', {
	root: root,
	page: page,
	pageTitle: '制作サイト一覧｜' + site.siteName,
	pageDescription: 'Web制作会社時代に手がけたサイトの一覧。' + site.description,
	pageCss: pageCss,
	pageJs: pageJs
}) -%>
<body id="top" data-page="<%= page %>" data-root="<%= root %>">
<!-- BEGIN #fullWrap -->
<div id="fullWrap">
<%- include('../../_inc/_loading') -%>
<%- include('../../_inc/_header', { root: root }) -%>
<main class="l-main">
	<article class="subArticle">
		<!-- BEGIN .worksIntro -->
		<section class="worksIntro js-scrani">
			<p class="worksIntro__count"><%= String(worksList.length).padStart(2, '0') %> SITES</p>
			<h1 class="worksIntro__head">
				<span class="worksIntro__head--char"><span class="worksIntro__head--charIn">W</span></span>
				<span class="worksIntro__head--char"><span class="worksIntro__head--charIn">O</span></span>
				<span class="worksIntro__head--char"><span class="worksIntro__head--charIn">R</span></span>
				<span class="worksIntro__head--char"><span class="worksIntro__head--charIn">K</span></span>
				<span class="worksIntro__head--char"><span class="worksIntro__head--charIn">S</span></span>
			</h1>
			<p class="worksIntro__lead">Web制作会社時代に手がけたサイト一覧</p>
		</section><!-- /.worksIntro -->
		<%
		// フィルタ選択肢はデータから自動生成（シートに項目が増えても追従する）
		const worksFilterGroups = [
			{ key: 'type', label: 'TYPE', values: [...new Set(worksList.map(function (w) { return w.type; }).filter(Boolean))] },
			{ key: 'tech', label: 'TECH', values: [...new Set(worksList.flatMap(function (w) { return w.tech || []; }))] },
			{ key: 'collab', label: 'COLLAB', values: [...new Set(worksList.flatMap(function (w) { return w.collab || []; }))] },
		];
		-%>
		<!-- BEGIN .worksFilter -->
		<div class="worksFilter js-scrani">
			<% worksFilterGroups.forEach(function (g) { -%>
			<div class="worksFilter__group js-worksFilterGroup" data-filter-key="<%= g.key %>">
				<p class="worksFilter__label"><%= g.label %></p>
				<ul class="worksFilter__lists">
					<li class="worksFilter__item">
						<button type="button" class="worksFilter__btn js-worksFilterBtn --is-current" data-filter-value="">ALL</button>
					</li>
					<% g.values.forEach(function (v) { -%>
					<li class="worksFilter__item">
						<button type="button" class="worksFilter__btn js-worksFilterBtn" data-filter-value="<%= v %>"><%= v %></button>
					</li>
					<% }); -%>
				</ul>
			</div><!-- /.worksFilter__group -->
			<% }); -%>
			<p class="worksFilter__count"><span class="worksFilter__count--num js-worksFilterCount"><%= worksList.length %></span> SITES</p>
		</div><!-- /.worksFilter -->
		<p class="worksFilterEmpty js-worksFilterEmpty">条件に合う案件がありません。フィルタを解除してください。</p>
		<!-- BEGIN .worksList -->
		<ol class="worksList">
			<% worksList.forEach(function (w) { -%>
			<li class="worksList__item js-scrani js-worksItem" data-type="<%= w.type %>" data-tech="<%= (w.tech || []).join('|') %>" data-collab="<%= (w.collab || []).join('|') %>">
				<p class="worksList__num" aria-hidden="true"></p>
				<div class="worksList__body">
					<h2 class="worksList__title"><%= w.title %></h2>
					<ul class="worksMeta">
						<% if (w.type) { -%>
						<li class="worksMeta__item -type"><%= w.type %></li>
						<% } -%>
						<% if (w.pages) { -%>
						<li class="worksMeta__item -pages"><%= w.pages %> PAGES</li>
						<% } -%>
						<% if (w.team) { -%>
						<li class="worksMeta__item -team"><%= w.team %></li>
						<% } -%>
						<% (w.collab || []).forEach(function (c) { -%>
						<li class="worksMeta__item -collab"><%= c %></li>
						<% }); -%>
					</ul>
					<ul class="worksTech">
						<% w.tech.forEach(function (t) { -%>
						<li class="worksTech__item"><%= t %></li>
						<% }); -%>
					</ul>
					<p class="worksList__desc"><%= w.description %></p>
				</div>
			</li>
			<% }); -%>
		</ol>
		<!-- END .worksList -->
		<p class="worksNote js-scrani">掲載しているのは一部です。このほかにも多数のサイト制作・保守を担当してきました。</p>
		<!-- BEGIN .worksMore -->
		<div class="worksMore js-scrani">
			<p class="worksMore__text">キャリア全体の代表作は PRODUCTS にまとめています</p>
			<a href="<%= root %>products/index.html" class="worksMore__btn js-pageTransitionLink"><span class="worksMore__btnTxt">代表作の詳細をみる</span></a>
		</div><!-- /.worksMore -->
	</article><!-- /.subArticle -->
</main>
<%- include('../../_inc/_footer', { root: root }) -%>
</div>
<!-- END #fullWrap -->

<%- include('../../_inc/_page-transition') -%>
<%- include('../../_inc/_modal', { root: root }) -%>
<%- include('../../_inc/_scripts', { root: root, pageJs: pageJs }) -%>
</body>
</html>
