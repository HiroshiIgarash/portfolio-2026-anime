<%
const root = '../';
const page = 'works';
const pageCss = null;
const pageJs = null;
-%>
<!doctype html>
<html lang="ja">
<%- include('../../_inc/_head', {
	root: root,
	page: page,
	pageTitle: '制作実績｜' + site.siteName,
	pageDescription: site.description,
	pageCss: pageCss,
	pageJs: pageJs
}) -%>
<body id="top" data-page="<%= page %>" data-root="<%= root %>">
<!-- BEGIN #fullWrap -->
<div id="fullWrap">
<%- include('../../_inc/_loading') -%>
<%- include('../../_inc/_header', { root: root }) -%>
<main class="l-main">
	<article class="subArticle">
		<h1 class="contTitle2">
			<span class="contTitle2__en font-cinzel">WORKS</span>
			<span class="contTitle2__ja">制作実績</span>
		</h1>
		<!-- BEGIN #content -->
		<section id="content" class="l-content">
			<!-- デザイン未確定のためプレースホルダ -->
		</section>
		<!-- END #content -->
	</article>
</main>
<%- include('../../_inc/_footer', { root: root }) -%>
</div>
<!-- END #fullWrap -->

<%- include('../../_inc/_modal', { root: root }) -%>
<%- include('../../_inc/_scripts', { root: root, pageJs: pageJs }) -%>
</body>
</html>
