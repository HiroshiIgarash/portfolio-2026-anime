<%
const root = './';
const page = 'top';
const pageCss = 'top';
const pageJs = 'top';
-%>
<!doctype html>
<html lang="ja">
<%- include('../_inc/_head', {
	root: root,
	page: page,
	pageTitle: site.siteName,
	pageDescription: site.description,
	pageCss: pageCss,
	pageJs: pageJs
}) -%>
<body id="top" data-page="<%= page %>" data-root="<%= root %>">
<!-- BEGIN #fullWrap -->
<div id="fullWrap">
<%- include('../_inc/_loading') -%>
<%- include('../_inc/_header', { root: root }) -%>
<main class="l-main">
	<!-- BEGIN #content -->
	<section id="content" class="l-content">
		<!-- デザイン未確定のためプレースホルダ -->
	</section>
	<!-- END #content -->
</main>
<%- include('../_inc/_footer', { root: root }) -%>
</div>
<!-- END #fullWrap -->

<%- include('../_inc/_modal', { root: root }) -%>
<%- include('../_inc/_scripts', { root: root, pageJs: pageJs }) -%>
</body>
</html>
