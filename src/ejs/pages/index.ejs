<%
const root = './';
const page = 'top';
const pageCss = 'top';
const pageJs = 'top';
-%>
<!doctype html>
<html lang="ja">
<%- include('../_inc/_head', {
	root: root,
	page: page,
	pageTitle: site.siteName,
	pageDescription: site.description,
	pageCss: pageCss,
	pageJs: pageJs
}) -%>
<body id="top" data-page="<%= page %>" data-root="<%= root %>">
<!-- BEGIN #fullWrap -->
<div id="fullWrap">
<%- include('../_inc/_loading-top') -%>
<%- include('../_inc/_header', { root: root }) -%>
<header id="mv" class="mv">
	<div class="mv__bg">
		<div class="mv__bgSwiper swiper js-mv__bgSwiper">
			<ul class="mv__bgSlideLists swiper-wrapper">
				<li class="mv__bgSlideList swiper-slide" data-visual="1">
					<picture>
						<source srcset="<%= root %>assets/img/top/mv1.webp" type="image/webp">
						<img src="<%= root %>assets/img/top/mv1.jpg" alt="空を見上げる少年と少女">
					</picture>
				</li>
				<li class="mv__bgSlideList swiper-slide" data-visual="2">
					<picture>
						<source srcset="<%= root %>assets/img/top/mv2.webp" type="image/webp">
						<img src="<%= root %>assets/img/top/mv2.jpg" alt="山頂へ続く道を歩く登山者">
					</picture>
				</li>
				<li class="mv__bgSlideList swiper-slide" data-visual="3">
					<picture>
						<source srcset="<%= root %>assets/img/top/mv3.webp" type="image/webp">
						<img src="<%= root %>assets/img/top/mv3.jpg" alt="バレーボールの試合の一場面">
					</picture>
				</li>
			</ul>
		</div>
	</div><!-- /.mv__bg -->
	<div class="mv__overlay"></div>
	<div class="mv__visualThumbArea">
		<ul class="mv__visualThumbLists">
			<li class="mv__visualThumbList">
				<button type="button" class="btn_visualChange js-visualChange --is-current" data-visual="1">
					<span class="hd">1枚目のビジュアルに切り替え</span>
				</button>
			</li>
			<li class="mv__visualThumbList">
				<button type="button" class="btn_visualChange js-visualChange" data-visual="2">
					<span class="hd">2枚目のビジュアルに切り替え</span>
				</button>
			</li>
			<li class="mv__visualThumbList">
				<button type="button" class="btn_visualChange js-visualChange" data-visual="3">
					<span class="hd">3枚目のビジュアルに切り替え</span>
				</button>
			</li>
		</ul>
	</div><!-- /.mv__visualThumbArea -->
	<div class="mv__catchWrap js-mv__catchWrap">
		<div class="mv__catch js-mv__catch">
			<h2 class="mv__catch--main">
				<span class="mv__catch--mainLine js-mv__catchLine">
					<span class="mv__catch--mainText js-mv__catchText">わくわくに満ちた</span>
					<span class="mv__catch--mainBand js-mv__catchBand"></span>
				</span>
				<span class="mv__catch--mainLine js-mv__catchLine">
					<span class="mv__catch--mainText js-mv__catchText">体験を。</span>
					<span class="mv__catch--mainBand js-mv__catchBand"></span>
				</span>
			</h2>
			<div class="mv__catch--lists">
				<p class="mv__catch--listsItem">Webサイトは、ただ情報を伝えるだけのものではないと考えています。訪れた人の心を動かし、期待や好奇心を生み出す、わくわくに満ちた体験を届けたいと思っています。</p>
				<p class="mv__catch--listsItem">アニメーションやインタラクションを駆使し、まるで魔法に触れたかのような新体験を創り出します。思わず驚き、夢中になってしまうような演出で、記憶に残る瞬間を届けます。</p>
				<p class="mv__catch--listsItem">ページを進めるたびに次が気になり、気付けば夢中になっている。そんな心躍る体験を通して、ユーザーとコンテンツをつなぐWebサイトを制作したいと考えています。</p>
			</div>
		</div>
	</div><!-- /.mv__catchWrap -->
</header><!-- /#mv -->
<main class="l-main">
	<div class="aboutProjectsWrap js-bgStage__wrap">
		<div class="bgStage js-bgStage">
			<div class="bgStage__layer -about">
				<picture>
					<source srcset="<%= root %>assets/img/top/about-bg.webp" type="image/webp">
					<img src="<%= root %>assets/img/top/about-bg.jpg" alt="">
				</picture>
			</div><!-- /.bgStage__layer.-about -->
			<div class="bgStage__layer -projects">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects-bg.webp" type="image/webp">
					<img src="<%= root %>assets/img/top/projects-bg.jpg" alt="">
				</picture>
			</div><!-- /.bgStage__layer.-projects -->
		</div><!-- /.bgStage -->
		<section id="about" class="about">
		<div class="about__left">
			<h2 class="about__head js-scrani">
				<span class="about__head--char"><span class="about__head--charIn">A</span></span>
				<span class="about__head--char"><span class="about__head--charIn">B</span></span>
				<span class="about__head--char"><span class="about__head--charIn">O</span></span>
				<span class="about__head--char"><span class="about__head--charIn">U</span></span>
				<span class="about__head--char"><span class="about__head--charIn">T</span></span>
			</h2>
			<div class="about__avatar">
				<button type="button" class="about__avatar--btn js-about__avatarChange">
					<img class="about__avatar--img --is-current" data-avatar="front" src="<%= root %>assets/img/about/avatar-front.png" alt="アバター(表)">
					<img class="about__avatar--img" data-avatar="back" src="<%= root %>assets/img/about/avatar-back.png" alt="アバター(裏)">
					<span class="hd">クリックしてアバターを切り替え</span>
				</button>
			</div>
		</div><!-- /.about__left -->
		<div class="about__right">
			<p class="about__text js-scrani">ダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミー。</p>
			<p class="about__text js-scrani">ダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミー。</p>
			<p class="about__text js-scrani">ダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミーダミー。</p>
		</div><!-- /.about__right -->
	</section><!-- /#about -->
		<section id="projects" class="projects">
			<h2 class="projects__head js-scrani">
				<span class="projects__head--char"><span class="projects__head--charIn">P</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">R</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">O</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">J</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">E</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">C</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">T</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">S</span></span>
			</h2>
			<%
			const projectsList = [
				{ modal: 'projectModal01', img: 'koremina', alt: 'コレミナ', label: '個人制作' },
				{ modal: 'projectModal02', img: 'holo-comment', alt: 'ホロライブコメント検索', label: '個人制作' },
				{ modal: 'projectModal03', img: 'tategamanga', alt: 'タテマンガ投稿Webサービス', label: 'Web開発会社' },
				{ modal: 'projectModal04', img: 'corporate', alt: 'コーポレートサイトリニューアル', label: 'Web開発会社' },
			];
			// Swiperのloopモードは実スライド数が少ないと自動的に無効化されるため、
			// 4作品を3セット(12スライド)複製して実スライド数を確保する。
			// 2セット目以降はaria-hiddenで補助技術から隠す。
			-%>
			<div class="projects__swiper swiper js-projectsSwiper">
				<ul class="swiper-wrapper">
					<% for (let rep = 0; rep < 3; rep++) { -%>
					<% projectsList.forEach(function (p) { -%>
					<li class="projects__slide swiper-slide js-projectsModalOpen" data-modal="<%= p.modal %>"<% if (rep > 0) { -%> aria-hidden="true"<% } -%>>
						<span class="projects__slide--balloon">Click me!</span>
						<span class="projects__slide--label<%= p.label === '個人制作' ? ' -personal' : ' -company' %>"><%= p.label %></span>
						<picture>
							<source srcset="<%= root %>assets/img/top/projects/<%= p.img %>.webp" type="image/webp">
							<img src="<%= root %>assets/img/top/projects/<%= p.img %>.jpg" alt="<%= p.alt %>">
						</picture>
						<p class="projects__slide--name"><%= p.alt %></p>
					</li>
					<% }); -%>
					<% } -%>
				</ul>
			</div><!-- /.projects__swiper -->
			<div class="projects__nav">
				<% projectsList.forEach(function (p, i) { -%>
				<button type="button" class="projects__nav--btn js-projectsNavBtn<% if (i === 0) { -%> --is-current<% } -%>" data-slide-index="<%= i %>">
					<span class="hd"><%= p.alt %>へ移動</span>
				</button>
				<% }); -%>
			</div><!-- /.projects__nav -->
			<div class="projects__more">
				<a href="<%= root %>products" class="projects__more--btn"><span class="projects__more--btnTxt">詳しくみる</span></a>
			</div>
		</section><!-- /#projects -->
	</div><!-- /.aboutProjectsWrap -->
	<div class="skillsFill">
		<div class="skillsFill__bgTrack">
			<div class="skillsFill__bg">
				<div class="skillsFill__circle js-skillsCircle"></div>
			</div>
		</div>
		<div class="skillsFill__spacer"></div>
	<section id="skills" class="skills">
		<h2 class="skills__head">
			<span class="skills__head--char"><span class="skills__head--charIn">S</span></span>
			<span class="skills__head--char"><span class="skills__head--charIn">K</span></span>
			<span class="skills__head--char"><span class="skills__head--charIn">I</span></span>
			<span class="skills__head--char"><span class="skills__head--charIn">L</span></span>
			<span class="skills__head--char"><span class="skills__head--charIn">L</span></span>
			<span class="skills__head--char"><span class="skills__head--charIn">S</span></span>
		</h2>
		<%
		const skillsList = [
			{ slug: 'html5', name: 'HTML', text: 'ダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキスト。' },
			{ slug: 'css', name: 'CSS', text: 'ダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキスト。' },
			{ slug: 'sass', name: 'SCSS', text: 'ダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキスト。' },
			{ slug: 'javascript', name: 'JavaScript', text: 'ダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキスト。' },
			{ slug: 'typescript', name: 'TypeScript', text: 'ダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキスト。' },
			{ slug: 'wordpress', name: 'WordPress(PHP)', text: 'ダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキスト。' },
			{ slug: 'nextdotjs', name: 'Next.js', text: 'ダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキスト。' },
			{ slug: 'react', name: 'React', text: 'ダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキストダミーテキスト。' },
		];
		-%>
		<div class="skills__menu">
			<% skillsList.forEach(function (s, i) { -%>
			<button type="button" class="skills__menu--btn js-skillsMenuBtn<% if (i === 0) { -%> --is-current<% } -%>" data-skill-index="<%= i %>" data-name="<%= s.name %>" data-text="<%= s.text %>">
				<img src="<%= root %>assets/img/top/skills/<%= s.slug %>.svg" alt="">
				<span class="hd"><%= s.name %></span>
			</button>
			<% }); -%>
		</div><!-- /.skills__menu -->
		<div class="skills__detail">
			<button type="button" class="skills__detail--prev js-skillsPrev">
				<span class="hd">前のスキルへ</span>
			</button>
			<div class="skills__detail--main">
				<div class="skills__detail--icon js-skillsDetailIcon">
					<img src="<%= root %>assets/img/top/skills/<%= skillsList[0].slug %>.svg" alt="">
				</div>
				<div class="skills__detail--body">
					<p class="skills__detail--name js-skillsDetailName js-scrani"><%= skillsList[0].name %></p>
					<p class="skills__detail--text js-skillsDetailText js-scrani"><%= skillsList[0].text %></p>
				</div>
			</div><!-- /.skills__detail--main -->
			<button type="button" class="skills__detail--next js-skillsNext">
				<span class="hd">次のスキルへ</span>
			</button>
		</div><!-- /.skills__detail -->
		<div class="skills__more">
			<a href="<%= root %>skills" class="skills__more--btn">詳しくみる</a>
		</div>
	</section><!-- /#skills -->
	</div><!-- /.skillsFill -->
	<div class="careerFill">
		<div class="careerFill__bgTrack">
			<div class="careerFill__bg">
				<div class="careerFill__circle js-careerCircle"></div>
			</div>
		</div>
		<div class="careerFill__spacer"></div>
	<section id="career" class="career">
		<!-- デザイン未確定のためプレースホルダ -->
	</section><!-- /#career -->
	</div><!-- /.careerFill -->
</main>
<%- include('../_inc/_footer', { root: root }) -%>
</div>
<!-- END #fullWrap -->

<%- include('../_inc/_page-transition') -%>
<%- include('../_inc/_modal', { root: root }) -%>
<%- include('../_inc/_scripts', { root: root, pageJs: pageJs }) -%>
</body>
</html>
