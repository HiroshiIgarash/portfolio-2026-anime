<%
const root = './';
const page = 'top';
const pageCss = 'top';
const pageJs = 'top';
-%>
<!doctype html>
<html lang="ja">
<%- include('../_inc/_head', {
	root: root,
	page: page,
	pageTitle: site.siteName,
	pageDescription: site.description,
	pageCss: pageCss,
	pageJs: pageJs
}) -%>
<body id="top" data-page="<%= page %>" data-root="<%= root %>">
<!-- BEGIN #fullWrap -->
<div id="fullWrap">
<%- include('../_inc/_loading-top') -%>
<%- include('../_inc/_header', { root: root }) -%>
<header id="mv" class="mv">
	<div class="mv__bg">
		<div class="mv__bgSwiper swiper js-mv__bgSwiper">
			<ul class="mv__bgSlideLists swiper-wrapper">
				<li class="mv__bgSlideList swiper-slide" data-visual="1">
					<picture>
						<source srcset="<%= root %>assets/img/top/mv1.webp" type="image/webp">
						<img src="<%= root %>assets/img/top/mv1.jpg" alt="空を見上げる少年と少女" width="1672" height="941">
					</picture>
				</li>
				<li class="mv__bgSlideList swiper-slide" data-visual="2">
					<picture>
						<source srcset="<%= root %>assets/img/top/mv2.webp" type="image/webp">
						<img src="<%= root %>assets/img/top/mv2.jpg" alt="山頂へ続く道を歩く登山者" width="1672" height="941">
					</picture>
				</li>
				<li class="mv__bgSlideList swiper-slide" data-visual="3">
					<picture>
						<source srcset="<%= root %>assets/img/top/mv3.webp" type="image/webp">
						<img src="<%= root %>assets/img/top/mv3.jpg" alt="バレーボールの試合の一場面" width="1672" height="941">
					</picture>
				</li>
			</ul>
		</div>
	</div><!-- /.mv__bg -->
	<div class="mv__overlay"></div>
	<div class="mv__visualThumbArea">
		<ul class="mv__visualThumbLists">
			<li class="mv__visualThumbList">
				<button type="button" class="btn_visualChange js-visualChange --is-current" data-visual="1">
					<picture>
						<source srcset="<%= root %>assets/img/top/mv1_thumb.webp" type="image/webp">
						<img src="<%= root %>assets/img/top/mv1_thumb.jpg" alt="" width="160" height="160">
					</picture>
					<span class="hd">1枚目のビジュアルに切り替え</span>
				</button>
			</li>
			<li class="mv__visualThumbList">
				<button type="button" class="btn_visualChange js-visualChange" data-visual="2">
					<picture>
						<source srcset="<%= root %>assets/img/top/mv2_thumb.webp" type="image/webp">
						<img src="<%= root %>assets/img/top/mv2_thumb.jpg" alt="" width="160" height="160">
					</picture>
					<span class="hd">2枚目のビジュアルに切り替え</span>
				</button>
			</li>
			<li class="mv__visualThumbList">
				<button type="button" class="btn_visualChange js-visualChange" data-visual="3">
					<picture>
						<source srcset="<%= root %>assets/img/top/mv3_thumb.webp" type="image/webp">
						<img src="<%= root %>assets/img/top/mv3_thumb.jpg" alt="" width="160" height="160">
					</picture>
					<span class="hd">3枚目のビジュアルに切り替え</span>
				</button>
			</li>
		</ul>
	</div><!-- /.mv__visualThumbArea -->
	<div class="mv__catchWrap js-mv__catchWrap">
		<div class="mv__catch js-mv__catch">
			<h2 class="mv__catch--main">
				<span class="mv__catch--mainLine js-mv__catchLine">
					<span class="mv__catch--mainText js-mv__catchText">わくわくに満ちた</span>
					<span class="mv__catch--mainBand js-mv__catchBand"></span>
				</span>
				<span class="mv__catch--mainLine js-mv__catchLine">
					<span class="mv__catch--mainText js-mv__catchText">体験を。</span>
					<span class="mv__catch--mainBand js-mv__catchBand"></span>
				</span>
			</h2>
			<div class="mv__catch--lists">
				<p class="mv__catch--listsItem">Webサイトは、ただ情報を伝えるだけのものではないと考えています。訪れた人の心を動かし、期待や好奇心を生み出す、わくわくに満ちた体験を届けたいと思っています。</p>
				<p class="mv__catch--listsItem">アニメーションやインタラクションを駆使し、まるで魔法に触れたかのような新体験を創り出します。思わず驚き、夢中になってしまうような演出で、記憶に残る瞬間を届けます。</p>
				<p class="mv__catch--listsItem">ページを進めるたびに次が気になり、気付けば夢中になっている。そんな心躍る体験を通して、ユーザーとコンテンツをつなぐWebサイトを制作したいと考えています。</p>
			</div>
		</div>
	</div><!-- /.mv__catchWrap -->
</header><!-- /#mv -->
<main class="l-main">
	<div class="aboutProjectsWrap js-bgStage__wrap">
		<div class="bgStage js-bgStage">
			<div class="bgStage__layer -about">
				<picture>
					<source srcset="<%= root %>assets/img/top/about-bg.webp" type="image/webp">
					<img src="<%= root %>assets/img/top/about-bg.jpg" alt="" width="1672" height="941">
				</picture>
			</div><!-- /.bgStage__layer.-about -->
			<div class="bgStage__layer -projects">
				<picture>
					<source srcset="<%= root %>assets/img/top/projects-bg.webp" type="image/webp">
					<img src="<%= root %>assets/img/top/projects-bg.jpg" alt="" width="1672" height="941">
				</picture>
			</div><!-- /.bgStage__layer.-projects -->
		</div><!-- /.bgStage -->
		<section id="about" class="about">
		<div class="about__left">
			<h2 class="about__head js-scrani">
				<span class="about__head--char"><span class="about__head--charIn">A</span></span>
				<span class="about__head--char"><span class="about__head--charIn">B</span></span>
				<span class="about__head--char"><span class="about__head--charIn">O</span></span>
				<span class="about__head--char"><span class="about__head--charIn">U</span></span>
				<span class="about__head--char"><span class="about__head--charIn">T</span></span>
			</h2>
		</div><!-- /.about__left -->
		<div class="about__right">
			<p class="about__text js-scrani">福島県会津若松出身。塾講師として中高生に数学を教えた2年半を経て、Web制作会社でコーディングの道へ。友人からは「いつも笑ってるね」と言われるくらいの明るい性格で、そのノリの良さは今の仕事でも変わりません。数十〜数百ページ規模のコーポレートサイト制作やWordPress構築を通して、マークアップとデザイン実装の地力を固めました。</p>
			<p class="about__text js-scrani">その後Web開発会社に転じ、大手出版社のタテマンガ投稿サービスの開発・保守に従事。フロントエンドからバックエンド、インフラまで横断しながら、コーディングの正確さとプロダクト開発の視点を両方育ててきました。</p>
			<p class="about__text js-scrani">個人開発でもコレミナ・ホロライブコメント検索を公開・運用中。近年はClaude Codeによる開発効率化に関心を持ち、実務での活かし方を試行錯誤しています。次は、あっと驚くようなアニメーションや演出に挑戦できる環境を探しています。</p>
		</div><!-- /.about__right -->
	</section><!-- /#about -->
		<section id="projects" class="projects">
			<h2 class="projects__head js-scrani">
				<span class="projects__head--char"><span class="projects__head--charIn">P</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">R</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">O</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">J</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">E</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">C</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">T</span></span>
				<span class="projects__head--char"><span class="projects__head--charIn">S</span></span>
			</h2>
			<%
			const projectsList = [
				{ modal: 'projectModal07', img: 'holdings', alt: '多角経営グループのコーポレートサイト制作', label: 'Web制作会社', type: 'agency', width: 1672, height: 941 },
				{ modal: 'projectModal01', img: 'hospital', alt: '総合病院コーポレートサイト制作', label: 'Web制作会社', type: 'agency', width: 1672, height: 941 },
				{ modal: 'projectModal08', img: 'candy', alt: '菓子ブランド公式サイトの保守・改修', label: 'Web制作会社', type: 'agency', width: 1672, height: 941 },
				{ modal: 'projectModal02', img: 'corporate', alt: 'Web制作期・コーポレートサイト多数', label: 'Web制作会社', type: 'agency', width: 1672, height: 941 },
				{ modal: 'projectModal03', img: 'koremina', alt: 'コレミナ', label: '個人制作', type: 'personal', width: 1200, height: 630 },
				{ modal: 'projectModal04', img: 'holo-comment', alt: 'ホロライブコメント検索', label: '個人制作', type: 'personal', width: 1200, height: 630 },
				{ modal: 'projectModal05', img: 'tategamanga', alt: 'タテマンガ投稿Webサービス', label: 'Web開発会社', type: 'company', width: 1672, height: 941 },
				{ modal: 'projectModal06', img: 'corporate', alt: 'コーポレートサイトリニューアル', label: 'Web開発会社', type: 'company', width: 1672, height: 941 },
			];
			// Swiperのloopモードは実スライド数が少ないと自動的に無効化されるため、
			// 4作品を3セット(12スライド)複製して実スライド数を確保する。
			// 2セット目以降はaria-hiddenで補助技術から隠す。
			-%>
			<div class="projects__swiper swiper js-projectsSwiper">
				<ul class="swiper-wrapper">
					<% for (let rep = 0; rep < 3; rep++) { -%>
					<% projectsList.forEach(function (p) { -%>
					<li class="projects__slide swiper-slide js-projectsModalOpen" data-modal="<%= p.modal %>"<% if (rep > 0) { -%> aria-hidden="true"<% } -%>>
						<span class="projects__slide--balloon">Click me!</span>
						<span class="projects__slide--label -<%= p.type %>"><%= p.label %></span>
						<picture>
							<source srcset="<%= root %>assets/img/top/projects/<%= p.img %>.webp" type="image/webp">
							<img src="<%= root %>assets/img/top/projects/<%= p.img %>.jpg" alt="<%= p.alt %>" width="<%= p.width %>" height="<%= p.height %>">
						</picture>
						<p class="projects__slide--name"><%= p.alt %></p>
					</li>
					<% }); -%>
					<% } -%>
				</ul>
			</div><!-- /.projects__swiper -->
			<div class="projects__nav">
				<% projectsList.forEach(function (p, i) { -%>
				<button type="button" class="projects__nav--btn js-projectsNavBtn<% if (i === 0) { -%> --is-current<% } -%>" data-slide-index="<%= i %>">
					<span class="hd"><%= p.alt %>へ移動</span>
				</button>
				<% }); -%>
			</div><!-- /.projects__nav -->
			<div class="projects__more">
				<a href="<%= root %>products/index.html" class="projects__more--btn"><span class="projects__more--btnTxt">詳しくみる</span></a>
			</div>
		</section><!-- /#projects -->
	</div><!-- /.aboutProjectsWrap -->
	<div class="skillsFill">
		<div class="skillsFill__bgTrack">
			<div class="skillsFill__bg">
				<div class="skillsFill__circle js-skillsCircle"></div>
			</div>
		</div>
		<div class="skillsFill__spacer"></div>
	<section id="skills" class="skills">
		<h2 class="skills__head">
			<span class="skills__head--char"><span class="skills__head--charIn">S</span></span>
			<span class="skills__head--char"><span class="skills__head--charIn">K</span></span>
			<span class="skills__head--char"><span class="skills__head--charIn">I</span></span>
			<span class="skills__head--char"><span class="skills__head--charIn">L</span></span>
			<span class="skills__head--char"><span class="skills__head--charIn">L</span></span>
			<span class="skills__head--char"><span class="skills__head--charIn">S</span></span>
		</h2>
		<%
		const skillsList = [
			{ slug: 'html5', name: 'HTML', text: 'Web制作会社時代から現在まで一貫して使用。コーポレートサイトから個人開発まで、セマンティックな構造とアクセシビリティを意識したマークアップを実践しています。' },
			{ slug: 'css', name: 'CSS', text: 'HTMLと同じくWeb制作会社時代から使用。デザインの忠実な再現とレスポンシブ対応を数十〜数百ページ規模の案件で数多く経験しました。' },
			{ slug: 'sass', name: 'SCSS', text: 'Web制作会社時代からテンプレート化・効率化のため使用。本ポートフォリオもコンポーネント単位で管理しやすい設計を意識して構築しています。' },
			{ slug: 'gsap', name: 'GSAP', text: 'ScrollTriggerを軸に、スクロール連動演出やタイムライン制御のアニメーションを実装。本ポートフォリオでも数多くの演出を組み上げています。' },
			{ slug: 'javascript', name: 'JavaScript(jQuery)', text: 'Web制作会社時代のjQuery実装から、現在のプロダクト開発でのモダンな実装まで継続使用。DOM操作からAPI連携まで幅広く扱います。' },
			{ slug: 'typescript', name: 'TypeScript', text: 'Web開発会社でのプロダクト開発から本格導入。個人開発のコレミナ・ホロライブコメント検索でも型安全な実装を心がけています。' },
			{ slug: 'wordpress', name: 'WordPress(PHP)', text: 'Web制作会社時代にテーマ開発・カスタム投稿タイプ設計を担当。Dockerを使ったローカル開発環境の整備まで一通り経験しています。' },
			{ slug: 'nextdotjs', name: 'Next.js', text: 'コレミナで独学から始め、現在は受託開発・個人開発の両方で使用。App Router移行やAPI連携まで実務で扱ってきました。' },
			{ slug: 'react', name: 'React', text: 'Next.jsを通じて日常的に使用。コンポーネント設計やstate管理を意識しながら、保守性の高い画面実装を心がけています。' },
		];
		-%>
		<div class="skills__menu">
			<% skillsList.forEach(function (s, i) { -%>
			<button type="button" class="skills__menu--btn js-skillsMenuBtn<% if (i === 0) { -%> --is-current<% } -%>" data-skill-index="<%= i %>">
				<img src="<%= root %>assets/img/top/skills/<%= s.slug %>.svg" alt="" width="24" height="24">
				<span class="hd"><%= s.name %></span>
			</button>
			<% }); -%>
		</div><!-- /.skills__menu -->
		<div class="skills__detail">
			<button type="button" class="skills__detail--prev js-skillsPrev">
				<span class="hd">前のスキルへ</span>
			</button>
			<div class="skills__detail--main js-skillsDetailWindow">
				<div class="skills__detail--track js-skillsDetailTrack">
					<% skillsList.forEach(function (s, i) { -%>
					<div class="skills__detail--slide js-skillsDetailSlide">
						<div class="skills__detail--icon">
							<img src="<%= root %>assets/img/top/skills/<%= s.slug %>.svg" alt="" width="24" height="24">
						</div>
						<div class="skills__detail--body">
							<p class="skills__detail--name js-skillsDetailName<% if (i === 0) { -%> js-scrani<% } %>"><%= s.name %></p>
							<p class="skills__detail--text js-skillsDetailText<% if (i === 0) { -%> js-scrani<% } %>"><%= s.text %></p>
						</div>
					</div>
					<% }); -%>
				</div><!-- /.skills__detail--track -->
			</div><!-- /.skills__detail--main -->
			<button type="button" class="skills__detail--next js-skillsNext">
				<span class="hd">次のスキルへ</span>
			</button>
		</div><!-- /.skills__detail -->
	</section><!-- /#skills -->
	</div><!-- /.skillsFill -->
	<section id="career" class="career js-scrani">
		<h2 class="career__head js-scrani">
			<span class="career__head--char"><span class="career__head--charIn">C</span></span>
			<span class="career__head--char"><span class="career__head--charIn">A</span></span>
			<span class="career__head--char"><span class="career__head--charIn">R</span></span>
			<span class="career__head--char"><span class="career__head--charIn">E</span></span>
			<span class="career__head--char"><span class="career__head--charIn">E</span></span>
			<span class="career__head--char"><span class="career__head--charIn">R</span></span>
		</h2>
		<%
		const careerList = [
			{ period: '2019 — 2022', title: '塾講師 · 2年半', text: '中3〜高2の数学を集団授業で担当。進路相談・三者面談も。人に教える経験は、その後のレビュー文化や後輩指導にも繋がっています。', deco: { type: 'image', src: 'juku', width: 240, height: 228 } },
			{ period: '2022 — 2024', title: 'Web制作会社にて<span class="career__item--noBreak">コーディング</span> · 2年半', text: '数十〜数百ページ規模のコーポレートサイト制作、WordPress構築、後輩指導。マークアップとデザイン実装の地力を固めた時期。', deco: { type: 'image', src: 'web-shokunin', width: 240, height: 197 } },
			{ period: '2024', title: 'コレミナ 公開', text: 'にじさんじの推し動画を投稿し合うファンサイトを、Next.js + Prisma + Neonで独学構築。AIなしで2ヶ月かけて作りきった、初の本格個人プロダクト。', deco: { type: 'css', shape: 'circle' } },
			{ period: '2024 — 2026', title: 'Web開発会社にて · <span class="career__item--noBreak">タテマンガ</span>投稿サービス開発', text: '大手出版社のタテマンガ投稿サービスを受託開発・保守。フロント中心にバックエンドも横断。並行して在籍企業のコーポレートサイトリニューアル(多言語化対応)も担当。', deco: { type: 'image', src: 'tategamanga', panel: true, width: 280, height: 373 } },
			{ period: '2025', title: '応用情報技術者試験 合格', text: '基礎知識を体系化する目的で取得。実務との往復で土台を強くした。', deco: { type: 'image', src: 'goukaku', width: 240, height: 170 } },
			{ period: '2026', title: 'ホロライブコメント検索 公開', text: 'Claude Codeとの協働開発を本格的に試した個人プロジェクト。1週間で公開、運用継続中。', deco: { type: 'css', shape: 'triangle' } },
			{ period: 'NOW · 2026', title: '新しい環境を求めて', text: 'Web制作会社で、あっと驚くようなアニメーションや演出に挑戦できる環境を探しています。', current: true },
		];
		-%>
		<div class="career__timeline js-careerTimeline">
			<svg class="career__lineSvg js-careerLineSvg" preserveAspectRatio="none">
				<defs>
					<linearGradient id="careerLineGradient" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#00afaa" />
						<stop offset="100%" stop-color="#ffaf00" />
					</linearGradient>
				</defs>
				<path class="career__linePath--deco js-careerLinePathDeco" />
				<path class="career__linePath--bg js-careerLinePathBg" />
				<path class="career__linePath--fill js-careerLinePathFill" />
			</svg>
			<div class="career__line">
				<div class="career__line--fill js-careerLineFill"></div>
			</div>
			<div class="career__orbTrail js-careerOrbTrail">
				<% for (let t = 0; t < 4; t++) { -%>
				<span class="career__orbTrail--dot js-careerOrbTrailDot"></span>
				<% } -%>
			</div>
			<div class="career__orb js-careerOrb">
				<% for (let p = 0; p < 6; p++) { -%>
				<span class="career__orb--particle js-careerOrbParticle"></span>
				<% } -%>
			</div>
			<ol class="career__list">
				<% careerList.forEach(function (c, i) { -%>
				<li class="career__item js-careerItem js-scrani <%= i % 2 === 0 ? '-left' : '-right' %><% if (c.current) { -%> --is-current<% } -%>">
					<span class="career__item--dot js-careerDot<% if (c.current) { -%> --is-current<% } -%>"></span>
					<% if (c.deco) { -%>
					<div class="career__item--deco js-careerDeco -<%= c.deco.type %>"<% if (c.deco.shape) { -%> data-deco-shape="<%= c.deco.shape %>"<% } %><% if (c.deco.panel) { -%> data-deco-panel<% } %>>
						<% if (c.deco.type === 'image') { -%>
						<picture>
							<source srcset="<%= root %>assets/img/top/career/<%= c.deco.src %>.webp" type="image/webp">
							<img src="<%= root %>assets/img/top/career/<%= c.deco.src %>.<%= c.deco.src === 'tategamanga' ? 'jpg' : 'png' %>" alt="" width="<%= c.deco.width %>" height="<%= c.deco.height %>">
						</picture>
						<% } -%>
					</div>
					<% } -%>
					<div class="career__item--body">
						<p class="career__item--period"><%= c.period %></p>
						<h3 class="career__item--title"><%- c.title %><% if (c.handNote) { -%> <span class="career__item--handNote"><%= c.handNote %></span><% } -%></h3>
						<p class="career__item--text"><%= c.text %></p>
					</div>
				</li>
				<% }); -%>
			</ol>
		</div><!-- /.career__timeline -->
	</section><!-- /#career -->
	<section id="private" class="private js-privateStage">
		<h2 class="private__head js-scrani">
			<span class="private__head--char"><span class="private__head--charIn">P</span></span>
			<span class="private__head--char"><span class="private__head--charIn">R</span></span>
			<span class="private__head--char"><span class="private__head--charIn">I</span></span>
			<span class="private__head--char"><span class="private__head--charIn">V</span></span>
			<span class="private__head--char"><span class="private__head--charIn">A</span></span>
			<span class="private__head--char"><span class="private__head--charIn">T</span></span>
			<span class="private__head--char"><span class="private__head--charIn">E</span></span>
		</h2>
		<div class="private__pin js-privatePin">
			<figure class="private__float -walk js-privateFloatA">
				<picture>
					<source srcset="<%= root %>assets/img/top/private/walk.webp" type="image/webp">
					<img src="<%= root %>assets/img/top/private/walk.jpg" alt="散歩中の風景" width="1672" height="941">
				</picture>
			</figure>
			<figure class="private__float -toy js-privateFloatB">
				<picture>
					<source srcset="<%= root %>assets/img/top/private/anime.webp" type="image/webp">
					<img src="<%= root %>assets/img/top/private/anime.jpg" alt="VTuber配信を観る" width="1672" height="941">
				</picture>
			</figure>
			<figure class="private__zoom js-privateZoom">
				<picture>
					<source srcset="<%= root %>assets/img/top/private/coding.webp" type="image/webp">
					<img src="<%= root %>assets/img/top/private/coding.jpg" alt="コーディング中のデスク" width="1672" height="941">
				</picture>
			</figure>
		</div><!-- /.private__pin -->
		<div class="private__pinBg js-privatePinBg"></div>
		<%
		const privateList = [
			{ img: 'walk',    alt: '散歩中の風景',        caption: '散歩' },
			{ img: 'akabeko', alt: '会津の郷土玩具 赤べこ', caption: '出身地は会津' },
			{ img: 'anime',   alt: 'VTuber配信を観る',     caption: 'にじさんじ' },
			{ img: 'maimai',  alt: '音楽ゲームをプレイする様子', caption: 'maimai' },
			{ img: 'coding',  alt: 'コーディング',         caption: '個人開発' },
		];
		-%>
		<div class="private__gallery js-privateGallery">
			<div class="private__swiper swiper js-privateSwiper">
				<ul class="swiper-wrapper">
					<% privateList.forEach(function (p) { -%>
					<li class="private__slide swiper-slide">
						<div class="private__slide--inner js-privateSlideInner">
							<picture>
								<source srcset="<%= root %>assets/img/top/private/<%= p.img %>.webp" type="image/webp">
								<img src="<%= root %>assets/img/top/private/<%= p.img %>.jpg" alt="<%= p.alt %>" width="1672" height="941">
							</picture>
							<p class="private__slide--caption"><%= p.caption %></p>
						</div>
					</li>
					<% }); -%>
				</ul>
				<div class="private__swiper--pagination js-privateSwiperPagination"></div>
			</div><!-- /.private__swiper -->
			<button type="button" class="private__nav -prev js-privateSwiperPrev"><span class="hd">前へ</span></button>
			<button type="button" class="private__nav -next js-privateSwiperNext"><span class="hd">次へ</span></button>
			<div class="private__more">
				<a href="<%= root %>private/index.html" class="private__more--btn"><span class="private__more--btnTxt">詳しくみる</span></a>
			</div>
		</div><!-- /.private__gallery -->
	</section><!-- /#private -->
	<section id="prism" class="prism js-prismStage">
		<picture class="prism__fallback">
			<source srcset="<%= root %>assets/img/top/mv1.webp" type="image/webp">
			<img src="<%= root %>assets/img/top/mv1.jpg" alt="" width="1672" height="941">
		</picture>
		<canvas class="prism__canvas js-prismCanvas"></canvas>
		<div class="prism__introOverlay js-prismIntroOverlay"></div>
		<p class="prism__introThanks js-prismIntroThanks">
			<%_ const prismThanksWords = 'THANK YOU FOR WATCHING!'.split(' '); _%><%_ prismThanksWords.forEach(function (word, wi) { _%><span class="prism__introThanks--word"><%_ word.split('').forEach(function (ch) { _%><span class="prism__introThanks--char js-prismIntroChar"><%- ch %></span><%_ }); _%></span><%_ if (wi < prismThanksWords.length - 1) { _%>&#32;<%_ } _%><%_ }); _%>
		</p>
	</section><!-- /#prism -->
</main>
<%- include('../_inc/_footer', { root: root }) -%>
</div>
<!-- END #fullWrap -->

<%- include('../_inc/_page-transition') -%>
<%- include('../_inc/_modal', { root: root }) -%>
<%- include('../_inc/_scripts', { root: root, pageJs: pageJs }) -%>
</body>
</html>
