{
	"name": "portfolio-2026-anime",
	"private": true,
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build:scss": "sass src/assets/scss:dist/assets/css --style=expanded --no-source-map",
		"watch:scss": "sass --watch src/assets/scss:dist/assets/css --style=expanded --no-source-map",
		"serve": "webpack serve --mode development",
		"build": "npm run build:scss && webpack --mode production",
		"dev": "npm-run-all --parallel watch:scss serve"
	},
	"devDependencies": {
		"copy-webpack-plugin": "^14.0.0",
		"ejs": "^6.0.1",
		"html-loader": "^5.1.0",
		"html-webpack-plugin": "^5.6.7",
		"npm-run-all": "^4.1.5",
		"playwright": "^1.61.1",
		"sass": "^1.83.0",
		"template-ejs-loader": "^0.9.4",
		"webpack": "^5.108.4",
		"webpack-cli": "^7.2.1",
		"webpack-dev-server": "^6.0.0"
	}
}
